<div class="container mt-5">
  <h1 class="text-center mb-4"><%= t('events.employees.title') %></h1>

  <!-- Tìm kiếm -->
  <div class="row mb-4 align-items-center">
    <div class="col-md-8">
      <%= search_form_for @q, url: employees_list_event_path(@event) do |f| %>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
          <%= f.text_field :name_cont, class: "form-control", placeholder: t('events.employees.search_placeholder') %>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-filter"></i> <%= t('events.employees.search_button') %>
          </button>
        </div>
      <% end %>
    </div>
    <div class="col-md-4 text-end">
      <div class="btn-group">
        <%= link_to t('events.employees.filters.all'), employees_list_event_path(@event), class: "btn btn-secondary me-2" %>
        <%= link_to t('events.employees.filters.participated'), employees_list_event_path(@event, status: 'participated'), class: "btn btn-success me-2" %>
        <%= link_to t('events.employees.filters.not_participated'), employees_list_event_path(@event, status: 'not_participated'), class: "btn btn-warning" %>
      </div>
    </div>
  </div>

  <!-- Bảng danh sách nhân viên -->
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
      <tr>
        <th scope="col"><%= t('events.employees.table.index') %></th>
        <th scope="col"><%= t('events.employees.table.name') %></th>
        <th scope="col"><%= t('events.employees.table.role') %></th>
        <th scope="col" class="text-center"><%= t('events.employees.table.actions') %></th>
      </tr>
      </thead>
      <tbody id="employee-table" data-event-id="<%= @event.id %>">
      <% @paginated_employees.each_with_index do |employee, index| %>
        <tr data-user-id="<%= employee[:id] %>">
          <td><%= (index + 1) + ((@paginated_employees.current_page - 1) * @paginated_employees.limit_value) %></td>
          <td><%= employee[:name] %></td>
          <td>
            <% if employee[:has_ticket] %>
              <select class="form-select change-role" data-user-id="<%= employee[:id] %>" data-event-id="<%= @event.id %>">
                <%= options_for_select(Ticket.event_roles.keys.map { |role| [role.humanize, role] }, employee[:role]) %>
              </select>
            <% else %>
              <span class="badge bg-secondary text-light"><%= t('events.employees.table.undefined') %></span>
            <% end %>
          </td>
          <td class="text-center">
            <% if employee[:has_ticket] %>
              <button class="btn btn-sm btn-danger remove-employee">
                <i class="fas fa-user-minus"></i> <%= t('events.employees.table.remove_employee') %>
              </button>
            <% else %>
              <button class="btn btn-sm btn-primary add-employee">
                <i class="fas fa-user-plus"></i> <%= t('events.employees.table.add_employee') %>
              </button>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <!-- Phân trang -->
  <nav aria-label="Pagination">
    <%= paginate @paginated_employees %>
  </nav>

  <script>
      $(document).ready(function () {
          function showAlert(message, type) {
              alert(message);
          }

          // Thêm nhân viên vào sự kiện
          $(document).on("click", ".add-employee", function () {
              const row = $(this).closest("tr");
              const userId = row.data("user-id");
              const eventId = $("#employee-table").data("event-id");

              $.ajax({
                  url: `/event/${eventId}/add_employee_to_event`,
                  method: "POST",
                  data: {user_id: userId},
                  success: function (response) {
                      showAlert("<%= t('events.employees.alerts.add_success') %>", "success");
                      location.reload();
                  },
                  error: function () {
                      showAlert("<%= t('events.employees.alerts.add_error') %>", "danger");
                  },
              });
          });

          // Xóa nhân viên khỏi sự kiện
          $(document).on("click", ".remove-employee", function () {
              const row = $(this).closest("tr");
              const userId = row.data("user-id");
              const eventId = $("#employee-table").data("event-id");

              $.ajax({
                  url: `/event/${eventId}/remove_employee_from_event`,
                  method: "DELETE",
                  data: {user_id: userId},
                  success: function (response) {
                      showAlert("<%= t('events.employees.alerts.remove_success') %>", "success");
                      location.reload();
                  },
                  error: function () {
                      showAlert("<%= t('events.employees.alerts.remove_error') %>", "danger");
                  },
              });
          });

          // Thay đổi vai trò
          $(document).on("change", ".change-role", function () {
              const selectElement = $(this);
              const userId = selectElement.data("user-id");
              const eventId = selectElement.data("event-id");
              const newRole = selectElement.val();

              $.ajax({
                  url: `/event/${eventId}/change_role`,
                  method: "POST",
                  data: {
                      user_id: userId,
                      role: newRole,
                  },
                  success: function (response) {
                      alert(response.message);
                  },
                  error: function () {
                      showAlert("<%= t('events.employees.alerts.role_update_error') %>", "danger");
                  },
              });
          });
      });
  </script>
</div>
