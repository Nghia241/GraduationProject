<div class="container mt-4">
  <h5 class="fw-bold mb-4">
    <i class="bi bi-calendar-plus"></i> <%= t('events.new.title') %>
  </h5>
  <%= form_with model: @event, url: event_index_path, local: true do |f| %>
    <div class="row">
      <!-- Cột hình ảnh -->
      <div class="col-md-3">
        <div class="mb-3">
          <%= f.label :image, t('events.new.image_label'), class: "form-label" %>
          <%= f.file_field :image, class: "form-control", onchange: "previewImage(event)" %>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= t('events.new.image_preview') %></label>
          <img id="imagePreview" src="#" alt="<%= t('events.new.image_preview') %>" class="img-fluid border d-none" />
        </div>
      </div>

      <!-- Cột thông tin -->
      <div class="col-md-9">
        <div class="mb-3">
          <%= f.label :name, t('events.new.name_label'), class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :start_time, t('events.new.start_time_label'), class: "form-label" %>
          <%= f.datetime_select :start_time, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :end_time, t('events.new.end_time_label'), class: "form-label" %>
          <%= f.datetime_select :end_time, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :location, t('events.new.location_label'), class: "form-label" %>
          <%= f.text_field :location, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :description, t('events.new.description_label'), class: "form-label" %>
          <%= f.text_area :description, class: "form-control", rows: 5 %>
        </div>

        <div class="text-end">
          <%= f.submit t('events.new.submit_button'), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
    function previewImage(event) {
        const reader = new FileReader();
        reader.onload = function() {
            const preview = document.getElementById('imagePreview');
            preview.src = reader.result;
            preview.classList.remove('d-none');
        };
        reader.readAsDataURL(event.target.files[0]);
    }
</script>
