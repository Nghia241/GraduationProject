<div class="container py-4">
  <h1 class="mb-4"><%= t('trash.title') %></h1>

  <!-- Form tìm kiếm -->
  <div class="mb-4">
    <%= search_form_for @q, url: trash_event_index_path, method: :get, html: { class: "row g-3" } do |f| %>
      <div class="col-md-10">
        <%= f.search_field :name_cont, class: "form-control", placeholder: t('trash.search_placeholder') %>
      </div>
      <div class="col-md-2">
        <%= f.submit "Tìm kiếm", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>

  <!-- Bảng hiển thị danh sách sự kiện -->
  <% if @events.any? %>
    <table class="table table-hover">
      <thead>
      <tr>
        <th><%= t('trash.name') %></th>
        <th><%= t('trash.start_time') %></th>
        <th><%= t('trash.end_time') %></th>
        <th><%= t('trash.actions') %></th>
      </tr>
      </thead>
      <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= event.name %></td>
          <td><%= event.start_time.strftime("%d-%m-%Y %H:%M") %></td>
          <td><%= event.end_time.strftime("%d-%m-%Y %H:%M") %></td>
          <td>
            <%= link_to t('trash.restore'), restore_event_path(event), method: :patch, class: "btn btn-success btn-sm", data: { confirm: t('trash.confirm_restore') } %>
            <%= link_to t('trash.delete'), delete_event_path(event), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: t('trash.confirm_delete') } %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>

    <!-- Phân trang -->
    <div class="d-flex justify-content-center">
      <%= paginate @events %>
    </div>
  <% else %>
    <p class="text-center"><%= t('trash.no_events') %></p>
  <% end %>
</div>
