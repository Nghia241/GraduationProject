<div class="container py-4">
  <h1 class="mb-4"><%= t('sidebar.trash') %></h1>

  <!-- Form tìm kiếm -->
  <div class="mb-4">
    <%= search_form_for @q, url: trash_event_index_path, method: :get, html: { class: "row g-3" } do |f| %>
      <div class="col-md-10">
        <%= f.search_field :name_cont, class: "form-control", placeholder: "Tìm kiếm sự kiện theo tên..." %>
      </div>
      <div class="col-md-2">
        <%= f.submit "Tìm kiếm", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>

  <!-- Bảng hiển thị danh sách sự kiện -->
  <table class="table table-hover">
    <thead>
    <tr>
      <th>Tên sự kiện</th>
      <th>Thời gian bắt đầu</th>
      <th>Thời gian kết thúc</th>
      <th>Hành động</th>
    </tr>
    </thead>
    <tbody>
    <% @events.each do |event| %>
      <tr>
        <td><%= event.name %></td>
        <td><%= event.start_time.strftime("%d-%m-%Y %H:%M") %></td>
        <td><%= event.end_time.strftime("%d-%m-%Y %H:%M") %></td>
        <td>
          <%= link_to "Khôi phục", restore_event_path(event), method: :patch, class: "btn btn-success btn-sm", data: { confirm: "Bạn có chắc muốn khôi phục sự kiện này?" } %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>

  <!-- Phân trang -->
  <div class="d-flex justify-content-center">
    <%= paginate @events %>
  </div>
</div>
