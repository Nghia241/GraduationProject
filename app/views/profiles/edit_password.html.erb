<div class="container mt-5 p-3">
  <h2 class="d-none d-md-block mb-4 text-center text-primary">
    <i class="fas fa-lock me-2"></i><%= t('profiles.edit_password.title') %>
  </h2>
  <h2 class="d-block d-md-none text-center mb-4 mt-3 text-primary">
    <i class="fas fa-lock me-2"></i><%= t('profiles.edit_password.title') %>
  </h2>

  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 mb-4">
      <div class="list-group shadow-sm">
        <a href="<%= profile_path %>" class="list-group-item list-group-item-action">
          <i class="fas fa-user-circle"></i> <%= t('profiles.edit_password.sidebar.personal_info') %>
        </a>
        <a href="<%= edit_password_profile_path %>" class="list-group-item list-group-item-action active">
          <i class="fas fa-lock"></i> <%= t('profiles.edit_password.sidebar.change_password') %>
        </a>
      </div>
    </div>

    <!-- Form đổi mật khẩu -->
    <div class="col-md-9">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <i class="fas fa-lock"></i> <%= t('profiles.edit_password.sidebar.change_password') %>
        </div>
        <div class="card-body">
          <%= form_with url: update_password_profile_path, method: :patch, local: true do |f| %>
            <div class="mb-4">
              <%= f.label :current_password, t('profiles.edit_password.form.current_password'), class: "form-label fw-bold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-key"></i></span>
                <%= f.password_field :current_password, class: "form-control", placeholder: t('profiles.edit_password.form.current_password') %>
              </div>
            </div>
            <div class="mb-4">
              <%= f.label :new_password, t('profiles.edit_password.form.new_password'), class: "form-label fw-bold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-key"></i></span>
                <%= f.password_field :new_password, class: "form-control", placeholder: t('profiles.edit_password.form.new_password') %>
              </div>
            </div>
            <div class="mb-4">
              <%= f.label :confirm_password, t('profiles.edit_password.form.confirm_password'), class: "form-label fw-bold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-key"></i></span>
                <%= f.password_field :confirm_password, class: "form-control", placeholder: t('profiles.edit_password.form.confirm_password') %>
              </div>
            </div>
            <div class="text-end">
              <%= f.submit t('profiles.edit_password.form.submit'), class: "btn btn-primary px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
