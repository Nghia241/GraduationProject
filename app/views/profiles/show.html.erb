<div class="container mt-5 p-3">
  <h2 class="d-none d-md-block mb-4 text-center text-primary">
    <i class="fas fa-user-edit me-2"></i><%= t('profiles.show.title') %>
  </h2>
  <h2 class="d-block d-md-none text-center mb-4 mt-3 text-primary">
    <i class="fas fa-user-edit me-2"></i><%= t('profiles.show.mobile_title') %>
  </h2>

  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 mb-4">
      <div class="list-group shadow-sm">
        <a href="<%= profile_path %>" class="list-group-item list-group-item-action active">
          <i class="fas fa-user-circle"></i> <%= t('profiles.show.sidebar.personal_info') %>
        </a>
        <a href="<%= edit_password_profile_path %>" class="list-group-item list-group-item-action">
          <i class="fas fa-lock"></i> <%= t('profiles.show.sidebar.change_password') %>
        </a>
      </div>
    </div>

    <!-- Form thông tin cá nhân -->
    <div class="col-md-9">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <i class="fas fa-user-edit"></i> <%= t('profiles.show.sidebar.personal_info') %>
        </div>
        <div class="card-body">
          <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
            <div class="mb-4">
              <%= f.label :name, t('profiles.show.form.name'), class: "form-label fw-bold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-user"></i></span>
                <%= f.text_field :name, class: "form-control", placeholder: t('profiles.show.form.name') %>
              </div>
            </div>
            <div class="mb-4">
              <%= f.label :email, t('profiles.show.form.email'), class: "form-label fw-bold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-envelope"></i></span>
                <%= f.email_field :email, class: "form-control", disabled: true, placeholder: t('profiles.show.form.email') %>
              </div>
            </div>
            <div class="mb-4">
              <%= f.label :language_id, t('profiles.show.form.language'), class: "form-label fw-bold" %>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="fas fa-language"></i></span>
                <%= f.select :language_id,
                             options_for_select([[t('profiles.show.form.language_options.english'), 1],
                                                 [t('profiles.show.form.language_options.vietnamese'), 2]], @user.language_id),
                             { prompt: t('profiles.show.form.select_language') },
                             { class: "form-select" } %>
              </div>
            </div>
            <div class="text-end">
              <%= f.submit t('profiles.show.form.submit'), class: "btn btn-primary px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
